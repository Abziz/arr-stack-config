# Copy this file to .env and edit the values:  cp .env.example .env

# --- User / timezone ---
# Run `id` on the host to find your user and group ids
PUID=1000
PGID=1000
# Timezone list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# --- Folders ---
# Where each app stores its database and settings (one subfolder per app)
CONFIG_ROOT=./configs
# Your media library. Must contain the downloads folder so imports can use hardlinks:
#   MEDIA_ROOT/movies, MEDIA_ROOT/tv-shows, MEDIA_ROOT/downloads, ...
MEDIA_ROOT=/mnt/media/media

# --- Ports on the host (change only if something else already uses them) ---
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
BAZARR_PORT=6767
FLARESOLVERR_PORT=8191
QBITTORRENT_PORT=8080
QBITTORRENT_TORRENT_PORT=6881
JELLYFIN_PORT=8096
